# ---- Server ----
PORT=4000
# Comma-separated list of allowed origins for CORS (frontend dev server, etc.)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ---- PostgreSQL (your office database) ----
# Either provide a single connection string...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resul_calendar
# ...or the individual parts (used only if DATABASE_URL is empty):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=resul_calendar
# Set to true when connecting to a managed DB that requires SSL
PGSSL=false
